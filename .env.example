# Copy this file to ".env" for local overrides (optional). Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string

# DATABASE_URL is automatically provided on Render (PostgreSQL).
# Leave it unset locally to use SQLite (app.db), or point it to PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional Geocoding & Places API key (falls back to OpenStreetMap Live API when unset):
GEOAPIFY_KEY=

# Optional AI Wedding Concierge configuration (falls back to offline Lebanese concierge when unset):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Google OAuth 2.0 / OpenID Connect credentials (Authlib):
# Redirect URI locally: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
